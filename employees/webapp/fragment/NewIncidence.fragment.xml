<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Panel>
        <headerToolbar>
            <Toolbar>
                <core:Icon
                    src="{=
                ${form>Type} === '0'? 'accept':
                ${form>Type} === '1'? 'alert' :
                ${form>Type} === '2'? 'error' : ''
                }"
                />
                <Title
                    text="{i18n>incidence} ({form>Index})"
                    wrapping="true"
                />
                <ToolbarSpacer/>
                <Button 
                        icon="sap-icon://save"
                        press="onSavePress"
                        type="Emphasized" />
                <Button 
                        icon="sap-icon://delete"
                        press="onDeletePress"
                        type="Reject" />
            </Toolbar>
        </headerToolbar>

        <content>
            <HBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Text text="{i18n>date}:" />
                    <DatePicker dateValue="{form>CreationDate}"
                                change="updateIncidenceDate" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Text text="{i18n>reason}:" />
                    <Input value="{form>Reason}"
                            change="updateIncidenceReason" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Text text="{i18n>type}:" />
                    <Select selectedKey="{form>Type}"
                            change="updateIncidenceType">
                        <core:Item
                            key="-1"
                            text="{i18n>empty}"
                        />
                        <core:Item
                            key="0"
                            text="{i18n>incidenceCorrect}"
                        />
                        <core:Item
                            key="1"
                            text="{i18n>incidencePending}"
                        />
                        <core:Item
                            key="2"
                            text="{i18n>incidenceError}"
                        />
                    </Select>
                </VBox>
            </HBox>
        </content>
    </Panel>
</core:FragmentDefinition>
