<mvc:View
    controllerName="com.logali.employees.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        text="{i18n>appTitle}"
                        wrapping="true"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <filterbar:FilterBar
                    search="onFilterSearch"
                    showClearOnFB="true"
                    clear="onClearPress"
                >
                    <filterbar:filterGroupItems>
                        <filterbar:FilterGroupItem
                            groupName="filters"
                            name="employee"
                            label="{i18n>labelEmployee}"
                            visibleInFilterBar="true"
                        >
                            <filterbar:control>
                                <Input id="filterEmployee" />
                            </filterbar:control>
                        </filterbar:FilterGroupItem>

                        <filterbar:FilterGroupItem
                            groupName="filters"
                            name="country"
                            label="{i18n>labelCountry}"
                            visibleInFilterBar="true"
                        >
                            <filterbar:control>
                                <ComboBox
                                    id="filterCountry"
                                    items="{countries>/Countries}"
                                    showSecondaryValues="true"
                                >
                                    <items>
                                        <core:ListItem
                                            key="{countries>code}"
                                            text="{countries>country}"
                                            additionalText="({countries>code})"
                                        />
                                    </items>
                                </ComboBox>
                            </filterbar:control>
                        </filterbar:FilterGroupItem>
                    </filterbar:filterGroupItems>
                </filterbar:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="table"
                items="{employees>/Employees}"
                growing="true"
                growingScrollToLoad="true"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title
                            text="{i18n>title}"
                            wrapping="true"
                        />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="{i18n>ID}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>fullName}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>country}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>city}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>postalCode}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{employees>EmployeeID}" />
                            <Text
                                text="{employees>LastName} {employees>FirstName}"
                            />
                            <Text text="{employees>Country}" />
                            <Text text="{employees>City}" />
                            <Text text="{employees>PostalCode}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
